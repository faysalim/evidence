          "roles": [
            "DEV",
            "TECH_LEAD"
          ]
        },
        {
          "from": [
            "DISPUTED"
          ],
          "to": "WITHDRAWN",
          "roles": [
            "QA"
          ],
          "requires_fields": [
            "reason"
          ]
        },
        {
          "from": [
            "DEFERRED"
          ],
          "to": "ACCEPTED",
          "roles": [
            "DEV",
