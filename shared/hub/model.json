          "to": "CONVERTED",
          "roles": [
            "QA"
          ],
          "requires_fields": [
            "reason"
          ],
          "doc": "Working-as-designed with no operator-accepted contract: becomes a docs finding, or DECIDE at its consequence severity. It does not close."
        },
        {
          "from": [
            "NEW",
            "ACCEPTED"
          ],
          "to": "WITHDRAWN",
          "roles": [
            "QA"
          ],
          "requires_fields": [
            "reason"
          ]
        },
        {
          "from": [
