    "case": {
      "doc": "A test case. Its oracle is the field that makes it a case; a case whose oracle is the product's own report of itself is not a case. Both action and oracle are required at creation -- principles.md claimed this was enforced before it was.",
      "initial": "DESIGNED",
      "create": [
        "QA",
        "DEV",
        "DESIGNER",
        "ANALYST"
      ],
      "transitions": [
        {
          "from": [
            "DESIGNED"
          ],
          "to": "PASS",
          "roles": [
            "QA",
            "DESIGNER",
            "ANALYST"
          ],
          "requires_fields": [
            "evidence"
          ]
        },
        {
          "from": [
            "DESIGNED"
          ],
          "to": "PASS_SHORT",
          "roles": [
            "QA"
          ],
          "requires_fields": [
            "evidence"
          ]
        },
        {
          "from": [
            "DESIGNED"
          ],
          "to": "FAIL",
          "roles": [
            "QA",
            "DESIGNER",
            "ANALYST"
          ],
          "requires_fields": [
            "evidence"
          ]
        },
        {
          "from": [
            "DESIGNED"
          ],
          "to": "BLOCKED",
          "roles": [
            "QA",
            "DESIGNER",
            "ANALYST"
          ],
          "requires_fields": [
            "reason"
          ]
        },
        {
          "from": [
            "DESIGNED"
          ],
          "to": "NOT_RUN",
          "roles": [
            "QA",
            "DESIGNER",
            "ANALYST"
          ],
          "requires_fields": [
            "reason"
          ]
        },
        {
          "from": [
            "DESIGNED"
          ],
          "to": "LONG",
          "roles": [
            "QA"
          ],
          "requires_fields": [
            "cutoff"
          ]
        },
        {
          "from": [
            "LONG"
          ],
          "to": "PASS",
          "roles": [
            "QA"
          ],
          "requires_fields": [
            "evidence"
          ]
        },
        {
          "from": [
            "LONG"
          ],
          "to": "FAIL",
          "roles": [
            "QA"
          ],
          "requires_fields": [
            "evidence"
          ]
        },
        {
          "from": [
            "PASS",
            "PASS_SHORT",
            "FAIL",
            "BLOCKED",
            "NOT_RUN",
            "LONG"
          ],
          "to": "DESIGNED",
          "roles": [
            "QA"
          ],
          "doc": "Re-arm for the next iteration. A case is never retired for passing.",
          "escape": true
        },
        {
          "from": [
            "NOT_RUN",
            "BLOCKED"
          ],
          "to": "NOT_RUN",
          "roles": [
            "QA"
          ],
          "requires_fields": [
            "reason"
          ]
        }
      ],
      "requires_fields_on_create": [
        "action",
        "oracle"
      ]
    },
    "finding": {
      "doc": "The four invariants of shared/contracts/qa-dev.md map onto this type exactly. NEW is not a resting state; DEV claims FIXED and only QA may CLOSE; a reopen keeps its id while a regression gets a new one; severity is QA's call and priority is the operator's.",
      "initial": "NEW",
      "create": [
        "QA",
        "DESIGNER",
        "WRITER",
        "ANALYST"
      ],
      "fields_owned_by": {
        "severity": [
          "QA",
          "DESIGNER",
          "WRITER",
          "ANALYST"
        ],
        "priority": [
          "OPERATOR"
        ]
      },
      "transitions": [
        {
          "from": [
            "NEW"
          ],
          "to": "ACCEPTED",
          "roles": [
            "DEV",
            "TECH_LEAD"
          ]
        },
        {
          "from": [
            "NEW"
          ],
          "to": "REJECTED",
