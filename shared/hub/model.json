{
  "schema_version": 1,
  "doc": "The work-item model. One source of truth for item types, their states, who may create them and who may move them. Adding a role or a type means adding rows here, never new code paths in hub.py. The general invariant is that the producer claims and a DIFFERENT role accepts: encoded as `roles` on each transition, plus `different_actor_from` where the same person must not grade their own work.",
  "roles": {
    "PM": "Product manager",
    "HEAD_OF_PRODUCT": "Head of product / sponsor",
    "RESEARCHER": "UX researcher",
    "BA": "Business analyst",
    "PO": "Product owner",
    "DELIVERY": "Project / delivery manager",
    "DESIGNER": "Designer",
    "DESIGN_LEAD": "Design lead",
    "TECH_LEAD": "Tech lead / engineering manager",
    "DEV": "Engineer",
    "QA": "QA engineer / QA lead",
    "WRITER": "Technical writer",
    "PMM": "Product marketing",
    "ANALYST": "Data / product analyst",
    "DEVOPS": "DevOps / platform / SRE: owns deploy, rollback, alerting and on-call",
    "SECURITY": "Security, privacy and compliance: owns the sign-offs a release needs",
    "SUPPORT": "Support / customer success: owns what happens after it ships",
    "OPERATOR": "The operator: the human who owns the decision, the budget and the release"
  },
  "field_vocabularies": {
    "confidence": [
      "observed",
      "authored",
      "reported",
      "inferred"
    ],
    "mode": [
      "new",
      "existing"
    ],
    "provenance": [
      "authored",
      "derived",
      "reconstructed"
    ],
    "owner_role": [
      "DEVOPS",
      "SECURITY",
      "SUPPORT"
    ],
    "instrumented": [
      "yes",
      "no",
      "not yet"
    ]
  },
  "link_types": [
    "gates",
    "realizes",
    "refines",
    "implements",
    "verifies",
    "fixes",
    "ships",
    "measures",
    "introduced_by",
    "supersedes",
    "blocks",
    "graded_by",
    "derived_from",
    "found_by"
  ],
  "chain": [
    "initiative",
    "prd",
    "requirement",
    "story",
    "design",
    "adr",
    "case",
    "finding",
    "fix",
    "release",
    "metric"
  ],
  "types": {
    "initiative": {
      "initial": "PROPOSED",
      "create": [
        "PM",
        "HEAD_OF_PRODUCT",
        "OPERATOR"
      ],
      "transitions": [
        {
          "from": [
            "PROPOSED"
          ],
          "to": "APPROVED",
          "roles": [
            "HEAD_OF_PRODUCT",
            "OPERATOR"
          ],
          "different_actor_from": [
            "PROPOSED"
          ]
        },
        {
          "from": [
            "PROPOSED"
          ],
          "to": "DECLINED",
          "roles": [
            "HEAD_OF_PRODUCT",
            "OPERATOR"
          ],
          "requires_fields": [
            "reason"
          ]
        },
        {
          "from": [
            "APPROVED"
          ],
          "to": "DELIVERED",
          "roles": [
            "DELIVERY",
            "PM"
          ],
          "escape": true
        }
      ]
    },
    "insight": {
      "initial": "DRAFT",
      "create": [
        "RESEARCHER",
        "PM",
        "ANALYST"
      ],
      "transitions": [
        {
          "from": [
