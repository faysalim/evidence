          "to": "IN_PROGRESS",
          "roles": [
            "DEV"
          ]
        },
        {
          "from": [
            "ACCEPTED",
            "IN_PROGRESS"
          ],
          "to": "FIXED",
          "roles": [
            "DEV"
          ],
          "requires_fields": [
            "commit",
            "build"
          ],
          "doc": "A claim about the code, not a verdict about the product."
        },
        {
          "from": [
            "FIXED"
          ],
          "to": "VERIFIED",
          "roles": [
            "QA"
          ],
          "different_actor_from": [
            "FIXED"
          ],
          "requires_fields": [
            "evidence",
            "variant_used"
          ]
        },
        {
          "from": [
            "FIXED"
          ],
          "to": "PARTIAL",
          "roles": [
            "QA"
          ],
          "different_actor_from": [
            "FIXED"
          ],
          "requires_fields": [
            "evidence",
            "variant_used"
          ]
        },
        {
          "from": [
            "FIXED"
          ],
          "to": "STILL_PRESENT",
          "roles": [
            "QA"
          ],
          "different_actor_from": [
            "FIXED"
          ],
          "requires_fields": [
            "evidence"
          ]
        },
        {
          "from": [
            "FIXED"
          ],
          "to": "NOT_IN_BUILD",
          "roles": [
            "QA"
          ],
          "requires_fields": [
            "evidence"
          ]
        },
        {
          "from": [
            "FIXED"
          ],
          "to": "CANNOT_RETEST",
          "roles": [
            "QA"
          ],
          "requires_fields": [
            "reason"
          ]
        },
        {
          "from": [
            "NOT_IN_BUILD",
            "CANNOT_RETEST",
            "PARTIAL",
            "STILL_PRESENT"
          ],
          "to": "ACCEPTED",
          "roles": [
