            "reason"
          ]
        },
        {
          "from": [
            "NEW"
          ],
          "to": "DEFERRED",
          "roles": [
            "DEV",
            "TECH_LEAD",
            "OPERATOR"
          ],
          "requires_fields": [
            "reason",
            "deferred_to"
          ]
        },
        {
          "from": [
            "NEW"
          ],
          "to": "DUPLICATE",
          "roles": [
            "DEV",
            "TECH_LEAD",
            "QA"
          ],
          "requires_fields": [
            "duplicate_of"
          ],
          "doc": "`duplicate_of` must name a different finding that exists. Unchecked, this was a one-command way for DEV to take a critical out of the verdict."
        },
        {
          "from": [
            "NEW"
          ],
          "to": "DISPUTED",
          "roles": [
