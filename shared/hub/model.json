          "from": [
            "NOT_GREEN",
            "NO_VERDICT"
          ],
          "to": "SHIPPED",
          "roles": [
            "OPERATOR"
          ],
          "requires_fields": [
            "reason"
          ],
          "doc": "Shipping without a green verdict is the operator's call, in writing."
        },
        {
          "from": [
            "SHIPPED"
          ],
          "to": "ROLLED_BACK",
          "roles": [
            "OPERATOR",
            "TECH_LEAD"
          ],
          "requires_fields": [
            "reason"
          ],
          "escape": true
        }
      ]
    },
    "doc": {
      "initial": "DRAFT",
      "create": [
        "WRITER"
      ],
      "transitions": [
        {
          "from": [
            "DRAFT"
          ],
          "to": "VERIFIED_AGAINST_PRODUCT",
          "roles": [
            "WRITER"
          ],
          "requires_fields": [
            "evidence"
          ],
          "doc": "Every claim executed verbatim. docs-conformance in reverse."
        },
        {
          "from": [
            "VERIFIED_AGAINST_PRODUCT"
          ],
          "to": "PUBLISHED",
          "roles": [
            "PM",
            "WRITER",
            "OPERATOR"
          ],
          "different_actor_from": [
            "DRAFT"
          ]
        },
        {
          "from": [
            "DRAFT",
            "VERIFIED_AGAINST_PRODUCT"
          ],
          "to": "CHANGES_REQUESTED",
          "roles": [
            "PM",
            "QA",
            "TECH_LEAD"
          ],
          "requires_fields": [
            "reason"
          ]
        },
        {
          "from": [
            "CHANGES_REQUESTED"
          ],
          "to": "DRAFT",
          "roles": [
            "WRITER"
          ],
          "doc": "As launch: a writer whose page was sent back must be able to resubmit it."
        }
      ]
    },
    "launch": {
      "initial": "DRAFT",
      "create": [
        "PMM"
      ],
      "transitions": [
        {
          "from": [
            "DRAFT"
          ],
          "to": "CLAIMS_CHECKED",
          "roles": [
            "PMM"
          ],
          "requires_fields": [
            "evidence",
            "claims_verified_by",
            "unverified_claims"
          ],
          "doc": "Every product claim links to a passing case or is flagged unverified."
        },
        {
          "from": [
            "CLAIMS_CHECKED"
          ],
          "to": "APPROVED",
          "roles": [
            "PM",
            "HEAD_OF_PRODUCT",
            "OPERATOR"
          ],
          "different_actor_from": [
            "DRAFT"
          ]
        },
        {
          "from": [
            "DRAFT",
            "CLAIMS_CHECKED"
          ],
          "to": "CHANGES_REQUESTED",
          "roles": [
            "PM",
            "QA",
            "OPERATOR"
          ],
          "requires_fields": [
            "reason"
          ]
        },
        {
          "from": [
            "APPROVED"
          ],
          "to": "LIVE",
          "roles": [
            "PMM",
            "OPERATOR"
          ]
        },
        {
          "from": [
            "CHANGES_REQUESTED"
          ],
          "to": "DRAFT",
          "roles": [
            "PMM"
          ],
          "doc": "Send-back, fix, resubmit is the normal review loop. Without this edge the only exit was a new id, which severs derived_from and the history time-in-state is built on."
        }
      ]
    },
    "metric": {
      "initial": "DEFINED",
      "create": [
        "PM",
        "ANALYST"
      ],
      "requires_fields_on_create": [
        "name",
        "denominator"
      ],
      "doc": "A success criterion. skills/prd says each metric is 'DEFINED with its denominator before anything is built', and skills/analytics opens by reading metrics 'against the denominator and baseline the PRD stated' -- so a DEFINED metric with no denominator hands analytics exactly the nothing it is written to avoid inventing. The denominator is definitional and sayable before any data exists, which is why it is required here while baseline is not: prd's own example records the baseline as 'unknown -- measuring is in scope', and the move to BASELINED demands a measured one.",
      "transitions": [
        {
          "from": [
            "DEFINED"
          ],
          "to": "BASELINED",
          "roles": [
            "ANALYST"
          ],
          "requires_fields": [
            "denominator",
            "baseline",
            "evidence"
          ]
        },
        {
          "from": [
            "BASELINED"
          ],
          "to": "READ",
          "roles": [
            "ANALYST"
          ],
          "requires_fields": [
            "value",
            "denominator",
            "evidence"
          ]
        },
        {
          "from": [
            "READ"
          ],
          "to": "INTERPRETED",
          "roles": [
            "PM",
            "HEAD_OF_PRODUCT"
          ],
          "different_actor_from": [
            "READ"
          ],
          "requires_fields": [
            "interpretation"
          ]
        },
        {
          "from": [
            "DEFINED",
            "BASELINED"
          ],
          "to": "NOT_MEASURABLE",
          "roles": [
            "ANALYST"
          ],
          "requires_fields": [
            "reason"
          ]
        },
        {
          "from": [
            "NOT_MEASURABLE"
          ],
          "to": "DEFINED",
          "roles": [
            "ANALYST"
          ],
          "requires_fields": [
            "reason"
          ],
          "doc": "Instrumentation arrives later. Without this edge the PRD's `measures` link pointed at a dead item the week the events shipped -- which for a new product is the normal path."
        }
      ]
    },
    "risk": {
      "initial": "OPEN",
      "create": [
        "DELIVERY",
        "TECH_LEAD",
        "PM",
        "QA"
      ],
      "transitions": [
        {
          "from": [
            "OPEN"
          ],
          "to": "MITIGATED",
          "roles": [
            "DELIVERY",
            "TECH_LEAD"
          ],
          "requires_fields": [
            "mitigation",
            "evidence"
          ]
        },
        {
          "from": [
            "OPEN"
          ],
          "to": "ACCEPTED",
          "roles": [
            "OPERATOR"
          ],
          "requires_fields": [
            "reason"
          ]
        },
        {
          "from": [
            "OPEN"
          ],
          "to": "REALIZED",
          "roles": [
            "DELIVERY",
            "TECH_LEAD",
            "QA"
          ],
          "requires_fields": [
            "evidence"
          ]
        },
        {
          "from": [
            "MITIGATED"
          ],
          "to": "CLOSED",
          "roles": [
            "DELIVERY"
          ],
          "different_actor_from": [
            "MITIGATED"
          ]
        }
      ]
    },
    "readiness": {
      "doc": "A release-readiness checkpoint owned by someone other than QA: a rollback rehearsed, an alert that fires, an on-call rota, a runbook, a certificate, a privacy or legal sign-off, a support macro, a post-launch watch plan. The release verdict reads these, so 'ready to ship' stops meaning 'QA found nothing'. MET needs evidence of the thing having been done, never an assurance that it will be. Only the operator may WAIVE one, with a reason, because deciding to ship without a rehearsed rollback is a decision and not an oversight. Import the team's own checkpoint list rather than adopting this suite's: skills/orient Step 3 says adopt, never impose.",
      "initial": "OPEN",
      "create": [
        "DEVOPS",
        "SECURITY",
        "SUPPORT",
        "DELIVERY",
        "TECH_LEAD",
        "OPERATOR"
      ],
      "requires_fields_on_create": [
        "title",
        "owner_role"
      ],
      "transitions": [
        {
          "from": [
            "OPEN"
          ],
          "to": "MET",
          "roles": [
            "DEVOPS",
            "SECURITY",
            "SUPPORT"
          ],
          "role_from_field": "owner_role",
          "requires_fields": [
            "evidence",
            "build"
          ]
        },
        {
          "from": [
            "OPEN"
          ],
          "to": "WAIVED",
          "roles": [
            "OPERATOR"
          ],
          "requires_fields": [
            "reason",
            "build"
          ]
        },
        {
          "from": [
            "MET",
            "WAIVED"
          ],
          "to": "OPEN",
          "roles": [
            "DEVOPS",
            "SECURITY",
            "SUPPORT",
            "DELIVERY",
            "TECH_LEAD",
            "QA"
          ],
          "requires_fields": [
            "reason"
          ]
        }
      ]
    },
    "cleanup": {
      "doc": "The cleanup ledger. Ordered by what is billing or exposed NOW. Teardown is verified by re-listing, never by a delete call's exit code.",
      "initial": "OPEN",
      "create": [
        "QA",
        "DEV",
        "DELIVERY",
        "TECH_LEAD"
      ],
      "transitions": [
        {
          "from": [
            "OPEN"
          ],
          "to": "TORN_DOWN",
          "roles": [
            "QA",
            "DEV",
            "DELIVERY",
            "TECH_LEAD"
          ],
          "requires_fields": [
            "verified_by"
          ],
          "doc": "verified_by must be a re-listing, e.g. 'billable instances: NONE'."
        },
        {
          "from": [
            "OPEN"
          ],
          "to": "OPERATORS",
          "roles": [
            "QA",
            "DEV",
            "DELIVERY"
          ],
          "requires_fields": [
            "reason"
          ],
          "doc": "Only the operator can remove it."
        },
        {
          "from": [
            "OPERATORS"
          ],
          "to": "TORN_DOWN",
          "roles": [
            "OPERATOR"
          ],
          "requires_fields": [
            "verified_by"
          ],
          "doc": "OPERATORS means only the operator can remove it, so the item must appear in THEIR queue. With no outgoing transition, waiting_on returned nothing and the queue never showed it."
        }
      ]
    }
  },
  "chain_links": {
    "initiative->prd": "realizes",
    "prd->requirement": "refines",
    "requirement->story": "realizes",
    "story->design": "realizes",
    "story->adr": "realizes",
    "story->case": "verifies",
    "case->finding": "found_by",
    "finding->fix": "fixes",
    "fix->release": "ships",
    "release->metric": "measures"
  },
  "default_checkpoints": {
    "doc": "The checkpoint set a release is gated on when the team has none of its own. Keys are stable; titles are this suite's wording and the team's wins. skills/orient imports their set into the profile as `required_checkpoints`, which overrides this entirely -- adopt, never impose. A `readiness` row names the key it satisfies in its `checkpoint` field, and the release verdict fails naming any required key with no MET or WAIVED row on that release's build.",
    "DEVOPS": {
      "rollback-rehearsed": "Rollback run on the candidate build, and timed",
      "rollback-data-path": "What happens to writes made after deploy and before rollback",
      "alert-fired": "An alert was deliberately triggered and the page arrived on-call",
      "on-call-named": "A named person and a backup, for the release window",
      "runbook-walked": "Walked by someone who did not write it, with where they stopped",
      "certs-quotas-secrets": "Expiry past the release horizon, rotation path tested",
      "capacity-limits": "Headroom at expected load, and the behaviour at the limit",
      "backup-restored": "A backup restored somewhere and the data read, not merely taken",
      "observability-new-surface": "The shipped surface is visible: metric, log or trace",
      "one-person-deploy": "Reversible by one person at 2 a.m., with access and no laptop dependency",
      "canary-staged-rollout": "Staged exposure defined: cohort, duration, and the promote/halt rule",
      "kill-switch": "The new behaviour can be turned off without a deploy, and that was exercised",
      "status-page": "Who updates it, with what wording, and the trigger to do so",
      "dns-email-auth": "DNS, SPF, DKIM and DMARC correct for any new sending or serving name"
    },
    "SECURITY": {
      "data-classification": "What classes of data the change touches, from schema and code",
      "privacy-signoff": "Named signer, date and scope where personal data is touched",
      "legal-signoff": "Where a term, licence or customer contract is implicated",
      "dependency-check": "Run against the candidate digest, with the result",
      "secrets-check": "No credential in the artifact, image, logs or client bundle",
      "authz-new-surface": "Every new route, flag or field exercised as a role that must not reach it",
      "audit-trail": "A new privileged action is attributable afterwards",
      "threat-model": "Updated, or explicitly stated unchanged",
      "consent-and-telemetry-observed": "Consent honoured and telemetry observed ON THE WIRE, not from the product's own setting"
    },
    "SUPPORT": {
      "known-issues-published": "Generated from open and DECIDE findings, each with symptom and workaround",
      "answers-prepared": "The questions this change predictably causes, answered in advance",
      "escalation-path": "Who support reaches by name in the window, and what they may do",
      "support-surfaces-updated": "Macros, canned replies and help-centre entries the change makes wrong",
      "watch-plan": "What, who, how long, and what would make us act",
      "volume-expectation": "Plausible effect on ticket volume, and whether the rota covers it",
      "support-trained": "Support walked the change themselves, not just read about it",
      "sales-cs-briefed": "Sales and customer success told what changed and what not to promise"
    }
  }
}
