        {
          "from": [
            "OPEN"
          ],
          "to": "WITHDRAWN",
          "roles": [
            "BA",
            "PM",
            "PO",
            "QA",
            "DEV",
            "TECH_LEAD",
            "DESIGNER",
            "DELIVERY",
            "ANALYST"
          ],
          "requires_fields": [
            "reason"
          ]
        }
      ]
    },
    "story": {
      "initial": "DRAFT",
      "create": [
        "PO",
        "BA"
      ],
      "transitions": [
        {
          "from": [
            "DRAFT"
          ],
          "to": "READY",
          "roles": [
            "PO"
          ],
